<%- layout("/layouts/boilerplate"); %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">

         <form method="POST"
          action="/listings/<%=listing._id%>?_method=PATCH"
          class="needs-validation"
          novalidate
          enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
        <input type="text" placeholder="Enter Title" name="listing[title]" value="<%=listing.title%>" class="form-control" id="title" required>
        <div class="invalid-feedback">Enter Correct Title</div>
        <div class="valid-feedback">Looks Good!</div>
        </div>
  
        <div class="mb-3">
            <label for="descp" class="form-label">Description</label>
        <textarea type="text" placeholder="Enter description" name="listing[description]" class="form-control" id="descp" required><%=listing.description%></textarea>
        <div class="invalid-feedback">Enter Correct Description</div>
        <div class="valid-feedback">Nice!</div>
        </div>

        <div class="mb-3">
            <label for="peview" class="form-label">Existing Image</label>
            <br>
            <img src="<%=originalImageUrl%>" id="preview">
        </div>
  
        <div class="mb-3">
            <label for="img" class="form-label">Upload to change Image</label>
        <input type="file" name="listing[image]" class="form-control" id="img">
        <div class="invalid-feedback">Enter Correctly</div>
        <div class="valid-feedback">Perfect</div>
        </div>
     
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
        <input type="Number" placeholder="Enter Price" name="listing[price]" value="<%=listing.price%>" class="form-control" id="price" required>
        <div class="invalid-feedback">Enter Correct Price</div>
        <div class="valid-feedback">Appealing</div>
        </div>
       
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
        <input type="text" placeholder="Enter Country" name="listing[country]" value="<%=listing.country%>" class="form-control" id="country" required>
        <div class="invalid-feedback">Enter Correct Country</div>
        <div class="valid-feedback">Exotic</div>
        </div>
        </div>
        <div class="mb-3">
            <label for="loc" class="form-label">Location</label>
        <input type="text" placeholder="Enter Location" name="listing[location]" value="<%=listing.location%>" class="form-control" id="loc" required>
        <div class="invalid-feedback">Enter Correct Location</div>
        <div class="valid-feedback">Exotic</div>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Make Changes</button>

    </form>
            </div>
    </div>
    <br>
    <br>

</body>
</html>